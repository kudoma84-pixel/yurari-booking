# Vercel の Settings → Environment Variables に設定してください。
# このファイル自体には実際の値を書かないでください（.gitignore で .env は除外済み）。

# ── Supabase ──────────────────────────────────
# サーバー側APIはサービスロールキーを使うのが望ましい（ブラウザには絶対に出さない）
SUPABASE_URL=https://pbjekdzmvjqhqbbrzbfk.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── セキュリティ（未設定だと保護が無効のままになります）──────
# /api/push-send を内部呼び出しのみに制限する。任意の長いランダム文字列。
INTERNAL_API_SECRET=
# /api/remind を cron からのみ実行可能にする。未設定だと誰でも実行できます。
CRON_SECRET=
# LINE Webhook の署名検証に必要。LINE Developers → Messaging API の
# 「チャネルシークレット」。未設定だと検証がスキップされます。
LINE_CHANNEL_SECRET=

# ── LINE ────────────────────────────────────
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
NEXT_PUBLIC_LIFF_ID_MYPAGE=

# ── メール（Resend）──────────────────────────
RESEND_API_KEY=

# ── Web Push ────────────────────────────────
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# ── NextAuth ────────────────────────────────
NEXTAUTH_URL=https://yurari-booking.vercel.app
NEXTAUTH_SECRET=
